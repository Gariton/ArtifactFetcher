{
  "name": "artifact-fetcher",
  "version": "4.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:https": "next dev --webpack --experimental-https --experimental-https-key=/etc/pki/tls/private/auth.key --experimental-https-cert=/etc/pki/tls/certs/auth.crt",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 --ignore-pattern .next --ignore-pattern next-env.d.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node scripts/run-tests.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "download": "node scripts/index.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@aws-sdk/lib-storage": "3.1112.0",
    "@mantine/core": "8.2.7",
    "@mantine/dropzone": "8.2.7",
    "@mantine/form": "8.2.7",
    "@mantine/hooks": "8.2.7",
    "@mantine/notifications": "8.2.7",
    "@npmcli/arborist": "10.0.2",
    "@tabler/icons-react": "^3.34.1",
    "axios": "1.19.0",
    "busboy": "^1.6.0",
    "eventsource": "^4.0.0",
    "nanoid": "6.0.1",
    "next": "16.3.1",
    "pacote": "22.0.0",
    "progress": "^2.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ssri": "14.0.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^20",
    "@types/npmcli__arborist": "^6.3.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tsx": "4.23.12",
    "typescript": "^5"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  }
}
